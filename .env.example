# CampusFlow ERP - Environment Variables Template
# DO NOT COMMIT REAL SECRETS OR PASSWORDS TO SOURCE CONTROL

# Application & API Configuration
API_PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# Database Connection (Primary)
# Format: postgres://<username>:<password>@<hostname>:<port>/<database_name>
DATABASE_URL=postgres://<db_user>:<db_password>@localhost:5432/campusflow_erp

# PostgreSQL Container Password (for Docker Compose setups)
POSTGRES_PASSWORD=<replace-with-secure-postgres-password>

# Discrete PostgreSQL Settings (Alternative to DATABASE_URL)
# PGHOST=localhost
# PGPORT=5432
# PGDATABASE=campusflow_erp
# PGUSER=campusflow
# PGPASSWORD=<replace-with-secure-postgres-password>
# PGSSLMODE=disable

# Authentication & Session Security
# Generate 256-bit random hex strings in production (e.g. node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
AUTH_ACCESS_TOKEN_SECRET=<replace-with-256-bit-access-token-secret>
AUTH_REFRESH_TOKEN_SECRET=<replace-with-256-bit-refresh-token-secret>
SESSION_COOKIE_NAME=campusflow_session
BCRYPT_COST=12

# Optional Mail / SMTP Server Configuration
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=<replace-with-smtp-username>
# SMTP_PASSWORD=<replace-with-smtp-password>
# SMTP_FROM="CampusFlow ERP <noreply@example.com>"