API_PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# Use DATABASE_URL for local development, CI, or production.
# Do not commit real usernames, passwords, hostnames, or tokens.
DATABASE_URL=postgres://<db_user>:<db_password>@<db_host>:5432/<db_name>

# Alternative discrete PostgreSQL settings. Leave commented unless used.
# PGHOST=localhost
# PGPORT=5432
# PGDATABASE=campusflow_erp
# PGUSER=campusflow_app
# PGPASSWORD=<replace-with-secure-password>
# PGSSLMODE=disable

# Future auth/session settings. Generate strong random values per environment.
AUTH_ACCESS_TOKEN_SECRET=<replace-with-access-token-secret>
AUTH_REFRESH_TOKEN_SECRET=<replace-with-refresh-token-secret>
SESSION_COOKIE_NAME=campusflow_session
BCRYPT_COST=12